{
  "enabledMcpjsonServers": ["github", "linear"],
  "permissions": {
    "allow": [
      "mcp__linear__get_issue",
      "mcp__linear__list_comments",
      "mcp__linear__get_attachment",
      "mcp__github__pull_request_read",
      "mcp__github__get_file_contents",
      "mcp__linear__save_comment"
    ],
    "deny": [
      "Read(.claude/settings.local.json)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.netrc)",
      "Read(~/.claude.json)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__github__.*|mcp__linear__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-mcp-tools.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-python.sh"
          }
        ]
      }
    ]
  }
}
